{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andyholst/trending-local-llms/data/model_contract.json",
  "title": "trending-local-llms model contract",
  "description": "JSON Schema that data/models.json must conform to. Every model in the 'models' array is validated against this. Enforced by scripts/validate.py.",
  "type": "object",
  "required": [
    "engines",
    "models"
  ],
  "properties": {
    "generated_utc": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "engines": {
      "type": "object",
      "description": "Engine registry. Key = engine name; every engine referenced by a model must exist here.",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9 ._()-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "backend",
          "note",
          "url"
        ],
        "properties": {
          "backend": {
            "type": "string",
            "enum": [
              "CUDA",
              "Metal",
              "CPU",
              "CUDA / CPU / Metal",
              "CUDA / Metal"
            ]
          },
          "note": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "description": "List of models. No duplicates (enforced by check_no_duplicates).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "full_name",
          "type",
          "formats",
          "license",
          "params",
          "vram_tier",
          "vram_min",
          "backends",
          "supported_engines",
          "engines",
          "why",
          "engagement",
          "last_seen"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.\\-]*$"
          },
          "name": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "formats": {
            "type": "array",
            "description": "Each format has its own name AND Hugging Face link.",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "hf"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "hf": {
                  "type": "string",
                  "description": "Hugging Face repo id for THIS format -> https://huggingface.co/<hf>"
                }
              },
              "additionalProperties": false
            }
          },
          "license": {
            "type": "string"
          },
          "params": {
            "type": "string"
          },
          "hf": {
            "type": "string",
            "description": "Primary Hugging Face repo id -> https://huggingface.co/<hf>"
          },
          "vram_tier": {
            "type": "string",
            "description": "VRAM category (8GB, 12GB, 16GB, ...)"
          },
          "vram_min": {
            "type": "string",
            "description": "LEAST required VRAM to run (e.g. '8GB')"
          },
          "backends": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "CUDA",
                "Metal",
                "CPU"
              ]
            }
          },
          "supported_engines": {
            "type": "array",
            "description": "Engines the model is supported by; each must have a measurement in 'engines'.",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "engines": {
            "type": "array",
            "description": "Per-engine t/s measurements. One entry per (engine, date).",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "engine",
                "tps",
                "date",
                "source_post"
              ],
              "properties": {
                "engine": {
                  "type": "string"
                },
                "tps": {
                  "type": "string",
                  "description": "Tokens/sec, always per engine."
                },
                "hardware": {
                  "type": "string"
                },
                "quant": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "source_post": {
                  "type": "string",
                  "format": "uri"
                },
                "likes": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Likes on the source X post backing this measurement (drives engagement-weighted t/s)."
                },
                "comments": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Comments on the source X post backing this measurement."
                },
                "reshares": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Reshares/reposts of the source X post backing this measurement (strongest engagement signal)."
                },
                "views": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Views of the source X post (reach; log-scaled in the engagement weight)."
                },
                "interactions": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Total interactions on the source X post (likes+comments+reshares+views or the platform's reported total)."
                }
              },
              "additionalProperties": false
            }
          },
          "why": {
            "type": "string"
          },
          "engagement": {
            "type": "object",
            "required": [
              "likes",
              "comments",
              "views",
              "last_7d_likes"
            ],
            "properties": {
              "likes": {
                "type": "integer",
                "minimum": 0
              },
              "comments": {
                "type": "integer",
                "minimum": 0
              },
              "views": {
                "type": "integer",
                "minimum": 0
              },
              "last_7d_likes": {
                "type": "integer",
                "minimum": 0
              },
              "seen_posts": {
                "type": "array",
                "description": "Post-granularity engagement: one entry per DISTINCT source X post (deduped by …/status/<id> URL; placeholder URLs are keyed by url+date+engine+tps). posts_7d / score_7d / last_7d_likes are computed from the entries dated within the last 7 days.",
                "items": {
                  "type": "object",
                  "required": [
                    "url",
                    "date"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "date": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "engine": {
                      "type": "string",
                      "description": "Engine of the measurement this post reported (optional)."
                    },
                    "tps": {
                      "type": "string",
                      "description": "t/s of the measurement this post reported (optional)."
                    },
                    "likes": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "likes on this post (optional)."
                    },
                    "comments": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "comments on this post (optional)."
                    },
                    "reshares": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "reshares on this post (optional)."
                    },
                    "views": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "views on this post (optional)."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "reshares": {
                "type": "integer",
                "minimum": 0,
                "description": "Total reshares/reposts across the model's source X posts (additive; optional)."
              },
              "interactions": {
                "type": "integer",
                "minimum": 0,
                "description": "Total interactions across the model's source X posts as reported by the platform (additive; optional)."
              },
              "posts_7d": {
                "type": "integer",
                "minimum": 0,
                "description": "Distinct source posts dated within the last 7 days (computed by sort_models)."
              },
              "score_7d": {
                "type": "number",
                "minimum": 0,
                "description": "7-day buzz: sum over posts_7d of likes + 2*comments + 3*reshares + log10(views+1), min 1 per post (computed by sort_models)."
              }
            },
            "additionalProperties": false
          },
          "last_seen": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
