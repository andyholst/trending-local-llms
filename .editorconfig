# EditorConfig — https://editorconfig.org
#
# The editor half of the same rule `make lint` enforces in CI (issue #186): a
# tracked text file ends with exactly one newline, with LF line endings. Anything
# the editor does here, `make lint-fix` can also repair for a file that arrived
# from anywhere else (the bots, an upstream paste, a container write).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.py]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,json5,toml,txt,in}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
